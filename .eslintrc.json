{
  "root": true,
  "extends": [
    "next/core-web-vitals"
  ],
  "env": {
    "browser": true,
    "node": true,
    "es2022": true
  },
  "globals": {
    "process": "readonly",
    "console": "readonly",
    "Buffer": "readonly"
  },
  "ignorePatterns": [
    "**/.quarantine/**",
    "**/docs/**",
    "**/tools/**",
    "**/scripts/**",
    "**/tests/**",
    "**/polaroid-mvp/**"
  ],
  "overrides": [
    {
      "files": [
        "*.cjs",
        "*.mjs",
        "next.config.*",
        "middleware.*"
      ],
      "env": {
        "node": true,
        "es2022": true
      },
      "globals": {
        "process": "readonly",
        "__dirname": "readonly",
        "__filename": "readonly",
        "require": "readonly",
        "module": "readonly",
        "Buffer": "readonly"
      }
    },
    {
      "files": [
        "scripts/**/*.{cjs,mjs,js}",
        "tools/**/*.{cjs,mjs,js}",
        "docs/**/*.{cjs,mjs,js}",
        "tests/**/*.{cjs,mjs,js}"
      ],
      "env": {
        "node": true,
        "es2022": true
      },
      "globals": {
        "process": "readonly",
        "__dirname": "readonly",
        "__filename": "readonly",
        "require": "readonly",
        "module": "readonly",
        "Buffer": "readonly"
      }
    }
  ],
  "rules": {
    "react-hooks/exhaustive-deps": "error",
    "@typescript-eslint/no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_"
      }
    ]
  }
}
