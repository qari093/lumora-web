#!/usr/bin/env bash
set -euo pipefail

# LUMORA_HARDENING_GITHOOKS_GUARDRAIL
# Prevent hooks from stripping tracked .lumora_* lock markers.
# If hook scripts do formatting or filtering, they must never touch .lumora_* files.

if git diff --cached --name-only | grep -Eq "^(\\.lumora_)"; then
  # allow commit; do not modify index entries for .lumora_*
  :
fi

# --- existing hook content below (if any) ---
#!/bin/sh
set -e

cd ~/lumora-web 2>/dev/null || exit 0

# Only enforce when contracts file is touched (staged or modified)
if git diff --name-only --cached | grep -q '^docs/nexa/contracts\.v1\.json$' || \
   git diff --name-only        | grep -q '^docs/nexa/contracts\.v1\.json$'; then
  sh scripts/nexa/contracts_freeze_check.sh
fi

exit 0
