#!/bin/sh
set -eu

# Prefer corepack + packageManager pin, but tolerate machines where corepack is quirky.
if command -v corepack >/dev/null 2>&1; then
  corepack enable >/dev/null 2>&1 || true
  PM="$(node -e "try{const p=require('./package.json');process.stdout.write(String(p.packageManager||''))}catch(e){process.stdout.write('')}" 2>/dev/null || true)"
  VER="10.28.1"
  case "$PM" in
    pnpm@10.*) VER="${PM#pnpm@}" ;;
  esac
  corepack prepare "pnpm@${VER}" --activate >/dev/null 2>&1 || true
fi

# Use whatever pnpm is now active (ideally corepack-provided).
if command -v pnpm >/dev/null 2>&1; then
  exec pnpm "$@"
fi

# Final fallback (rare): npm exec
exec npm exec --yes --package=pnpm@10 -- pnpm "$@"
