# Lumora — example env (SAFE, no secrets)
# Copy to .env.local (never commit) and fill with real values.

# Runtime
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Billing (Stripe) — placeholders only
STRIPE_SECRET_KEY=__REPLACE_ME__
STRIPE_WEBHOOK_SECRET=__REPLACE_ME__
STRIPE_PRICE_ID=__REPLACE_ME__

# Auth / tokens — placeholders only
JWT_SECRET=__REPLACE_ME__
