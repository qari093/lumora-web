# Lumora — example env (SAFE, no secrets)
# Copy to .env.local (never commit) and fill with real values.

# Runtime
NODE_ENV=development
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Billing (Stripe) — placeholders only
STRIPE_SECRET_KEY=<SET_IN_SECRET_MANAGER>
STRIPE_WEBHOOK_SECRET=<SET_IN_SECRET_MANAGER>
STRIPE_PRICE_ID=<SET_PER_ENVIRONMENT>

# Auth / tokens — placeholders only
JWT_SECRET=<SET_IN_SECRET_MANAGER>

# Vibe Tags Lite (default OFF)
LUMORA_VIBE_TAGS_LITE=0
NEXT_PUBLIC_LUMORA_VIBE_TAGS_LITE=0
