diff --git a/tests/_helpers/ensureServer.ts b/tests/_helpers/ensureServer.ts
new file mode 100644
index 00000000..5306a626
--- /dev/null
+++ b/tests/_helpers/ensureServer.ts
@@ -0,0 +1,23 @@
+import { startNextTestServer, stopNextTestServer, getNextTestBaseUrl } from "./nextTestServer";
+
+type EnsureOpts = { timeoutMs?: number; port?: number; quiet?: boolean };
+
+export async function ensureServer(opts: EnsureOpts = {}) {
+  await startNextTestServer({
+    timeoutMs: opts.timeoutMs ?? 60000,
+    port: opts.port ?? (Number(process.env.PORT) || 3000),
+    quiet: opts.quiet ?? true,
+  });
+  // Ensure BASE_URL is stable for callers that read it
+  if (!process.env.BASE_URL || process.env.BASE_URL === "/" ) {
+    process.env.BASE_URL = getNextTestBaseUrl();
+  }
+}
+
+export async function shutdownServer() {
+  await stopNextTestServer();
+}
+
+export function baseUrl() {
+  return getNextTestBaseUrl();
+}
diff --git a/tests/_helpers/nextTestServer.ts b/tests/_helpers/nextTestServer.ts
new file mode 100644
index 00000000..79ca7488
--- /dev/null
+++ b/tests/_helpers/nextTestServer.ts
@@ -0,0 +1,108 @@
+import { spawn, type ChildProcess } from "node:child_process";
+import { existsSync } from "node:fs";
+
+type StartOpts = {
+  port?: number;
+  timeoutMs?: number;
+  quiet?: boolean;
+};
+
+let child: ChildProcess | null = null;
+let starting: Promise<void> | null = null;
+let startedPort = 3000;
+
+function sleep(ms: number) {
+  return new Promise((r) => setTimeout(r, ms));
+}
+
+async function waitFor(url: string, timeoutMs: number) {
+  const started = Date.now();
+  let lastErr = "unknown";
+  while (Date.now() - started < timeoutMs) {
+    try {
+      const ac = new AbortController();
+      const t = setTimeout(() => ac.abort(), 3000);
+      try {
+        const res = await fetch(url, { cache: "no-store", signal: ac.signal as any });
+        if (res.ok) return;
+        lastErr = `http:${res.status}`;
+      } finally {
+        clearTimeout(t);
+      }
+    } catch (e: any) {
+      lastErr = (e && e.message) ? String(e.message) : "fetch_failed";
+    }
+    await sleep(250);
+  }
+  throw new Error(`nextTestServer: not healthy within ${timeoutMs}ms (last=${lastErr})`);
+}
+
+export async function startNextTestServer(opts: StartOpts = {}) {
+  if (child && child.exitCode === null) return;
+  if (starting) return starting;
+
+  const port = Number.isFinite(opts.port) ? (opts.port as number) : (Number(process.env.PORT) || 3000);
+  const timeoutMs = Number.isFinite(opts.timeoutMs) ? (opts.timeoutMs as number) : 60000;
+  startedPort = port;
+
+  // Prefer pnpm dev if available in repo; fallback to npx next dev
+  const usePnpm = existsSync("pnpm-lock.yaml");
+  const cmd = usePnpm ? "pnpm" : "npx";
+  const args = usePnpm ? ["-s", "dev", "-p", String(port)] : ["--yes", "next", "dev", "-p", String(port)];
+
+  starting = new Promise<void>((resolve, reject) => {
+    child = spawn(cmd, args, {
+      stdio: opts.quiet ? "ignore" : "pipe",
+      env: {
+        ...process.env,
+        NODE_ENV: "development",
+        PORT: String(port),
+        NEXT_TELEMETRY_DISABLED: "1",
+        CI: "1",
+      },
+    });
+
+    child.on("error", (e) => reject(e));
+    child.on("exit", (code, signal) => {
+      if (code !== null && code !== 0) {
+        reject(new Error(`nextTestServer exited code=${code} signal=${signal ?? "none"}`));
+      }
+    });
+
+    // Wait for health
+    (async () => {
+      try {
+        const base = `http://127.0.0.1:${port}`;
+        await waitFor(`${base}/api/health`, timeoutMs);
+        resolve();
+      } catch (e) {
+        try { child?.kill("SIGTERM"); } catch {}
+        reject(e);
+      } finally {
+        starting = null;
+      }
+    })();
+  });
+
+  return starting;
+}
+
+export async function stopNextTestServer() {
+  starting = null;
+  if (!child) return;
+  const p = child;
+  child = null;
+
+  try { p.kill("SIGTERM"); } catch {}
+  // give it a moment then SIGKILL if needed
+  for (let i = 0; i < 20; i++) {
+    if (p.exitCode !== null) return;
+    await sleep(150);
+  }
+  try { p.kill("SIGKILL"); } catch {}
+}
+
+export function getNextTestBaseUrl() {
+  const port = Number(process.env.PORT) || startedPort || 3000;
+  return process.env.BASE_URL || `http://127.0.0.1:${port}`;
+}
