# Lumora — CI env example (SAFE)
# Used by CI runners; do NOT store real secrets in repo.

NODE_ENV=production
NEXT_PUBLIC_BASE_URL=http://127.0.0.1:3000

# Use CI secret store to inject real values if needed
STRIPE_SECRET_KEY=__CI_SECRET__
STRIPE_WEBHOOK_SECRET=__CI_SECRET__
JWT_SECRET=__CI_SECRET__
