import { NextResponse } from 'next/server';

type JsonInit = ResponseInit & {
  status?: number;
};

export function guardedJson<T>(data: T, init: JsonInit = {}) {
  return NextResponse.json(data, {
    status: init.status ?? 200,
    headers: {
      'cache-control': 'no-store',
      ...(init.headers ?? {}),
    },
  });
}

export function guardedError(message = 'internal_error', status = 500) {
  return guardedJson({ ok: false, error: message }, { status });
}
