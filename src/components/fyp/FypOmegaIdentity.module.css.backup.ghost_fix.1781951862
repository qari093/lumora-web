.topBar{
position:absolute;
top:calc(env(safe-area-inset-top) + 18px);
left:20px;
right:20px;
z-index:20;
display:flex;
align-items:center;
gap:12px;
pointer-events:none;
}

.blade{
width:14px;
height:46px;
border-radius:999px;
background:linear-gradient(180deg,#7dd3fc 0%,#2563eb 100%);
box-shadow:0 0 18px rgba(34,211,238,.95),0 0 42px rgba(37,99,235,.55);
pointer-events:auto;
}

.word{
font-size:15px;
font-weight:900;
letter-spacing:.46em;
color:rgba(240,249,255,.96);
text-shadow:0 0 12px rgba(255,255,255,.45),0 0 28px rgba(34,211,238,.3);
pointer-events:auto;
}

.pill{
height:48px;
padding:0 20px;
border-radius:999px;
display:flex;
align-items:center;
gap:8px;
font-size:18px;
font-weight:850;
color:white;
background:rgba(18,22,31,.58);
border:1px solid rgba(34,211,238,.58);
backdrop-filter:blur(24px);
box-shadow:inset 0 0 18px rgba(34,211,238,.13),0 0 26px rgba(34,211,238,.26);
pointer-events:auto;
}

.count{
height:48px;
min-width:72px;
padding:0 16px;
border-radius:999px;
display:flex;
align-items:center;
justify-content:center;
font-size:16px;
font-weight:800;
color:rgba(255,255,255,.9);
background:rgba(28,28,34,.60);
border:1px solid rgba(255,255,255,.12);
backdrop-filter:blur(24px);
pointer-events:auto;
}


.logoWrap{
width:48px;
height:48px;
display:flex;
align-items:center;
justify-content:center;
pointer-events:auto;
}

.logo{
object-fit:contain;
filter:
drop-shadow(0 0 10px rgba(34,211,238,.85))
drop-shadow(0 0 24px rgba(59,130,246,.55));
}
